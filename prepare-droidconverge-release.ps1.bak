# DroidConverge release preflight script
# Runs from repository root. It never commits or pushes.
# It recovers selected checkpoint material, integrates without blind overwrites,
# creates missing setup/docs, checks hygiene, builds/tests Android, and reports blockers.

[CmdletBinding()]
param(
    [switch]$KeepRecovery,
    [switch]$SkipAdb,
    [switch]$SkipAndroidBuild,
    [switch]$SkipAndroidInstall,
    [switch]$SkipDocs
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$Repo = (Get-Location).Path
if (-not (Test-Path (Join-Path $Repo '.git'))) { throw 'Eseguire lo script dalla root del repository DroidConverge.' }

$Work = Join-Path $Repo '.release-work'
$Recovery = Join-Path $Repo 'checkpoint-recovery'
$LogDir = Join-Path $Work 'logs'
$Report = Join-Path $Work 'release-preflight-report.txt'
$Adb = 'C:\Users\Ciro\Desktop\platform-tools\adb.exe'
$LogFile = Join-Path $LogDir ("run-{0:yyyyMMdd-HHmmss}.log" -f (Get-Date))
$Failures = New-Object System.Collections.Generic.List[string]
$Warnings = New-Object System.Collections.Generic.List[string]
$Actions = New-Object System.Collections.Generic.List[string]
New-Item -ItemType Directory -Force $Work,$Recovery,$LogDir | Out-Null

function Write-Log {
    param([string]$Message,[ValidateSet('INFO','OK','WARN','ERROR')][string]$Level='INFO')
    $line = "[{0:yyyy-MM-dd HH:mm:ss}] [{1}] {2}" -f (Get-Date),$Level,$Message
    Write-Host $line
    Add-Content -LiteralPath $LogFile -Value $line -Encoding UTF8
}
function Add-Ok([string]$m){$Actions.Add($m);Write-Log $m OK}
function Add-Warn([string]$m){$Warnings.Add($m);Write-Log $m WARN}
function Add-Fail([string]$m){$Failures.Add($m);Write-Log $m ERROR}

function Run-Native {
    param([string]$FilePath,[string[]]$Arguments,[string]$WorkingDirectory=$Repo,[int[]]$AllowedExitCodes=@(0))
    Push-Location $WorkingDirectory
    try { $out = & $FilePath @Arguments 2>&1; $code = $LASTEXITCODE }
    finally { Pop-Location }
    if ($out) { $out | Tee-Object -FilePath $LogFile -Append | Out-Host }
    if ($AllowedExitCodes -notcontains $code) { throw "Comando fallito ($code): $FilePath $($Arguments -join ' ')" }
    return @($out)
}

function Ensure-GitIgnore([string]$Rule) {
    $p = Join-Path $Repo '.gitignore'
    $c = if(Test-Path $p){Get-Content -Raw $p}else{''}
    if($c -notmatch [regex]::Escape($Rule)){ Add-Content -LiteralPath $p -Value "`r`n$Rule`r`n" -Encoding UTF8; Add-Ok "Aggiunto a .gitignore: $Rule" }
}
function Copy-NoOverwrite([string]$Source,[string]$Destination) {
    New-Item -ItemType Directory -Force (Split-Path -Parent $Destination) | Out-Null
    if(-not(Test-Path $Destination)){ Copy-Item $Source $Destination -Force; Add-Ok "Importato: $Destination"; return }
    $a=(Get-FileHash $Source -Algorithm SHA256).Hash; $b=(Get-FileHash $Destination -Algorithm SHA256).Hash
    if($a -eq $b){ Add-Ok "Già presente e identico: $Destination"; return }
    $conf=Join-Path $Recovery ('conflicts\'+$Destination.Substring($Repo.Length).TrimStart('\'))
    New-Item -ItemType Directory -Force (Split-Path -Parent $conf) | Out-Null
    Copy-Item $Source $conf -Force
    Add-Warn "Conflitto preservato senza sovrascrittura: $Destination -> $conf"
}

function Recover-Termux {
    if($SkipAdb){ Add-Warn 'ADB recovery saltata (-SkipAdb).'; return }
    if(-not(Test-Path $Adb)){ Add-Warn "ADB non trovato: $Adb"; return }
    $devices = & $Adb devices 2>&1 | Out-String
    if($devices -notmatch '(?m)^\S+\s+device\s*$'){ Add-Warn 'Nessun dispositivo ADB online; uso eventuale recovery locale.'; return }
    $root = Join-Path $Recovery 'termux\droidconverge-recovery'
    if(Test-Path (Join-Path $root 'start-ubuntu-kde.sh')){ Add-Ok 'Recovery Termux già disponibile localmente.'; return }
    $remote='/data/local/tmp/droidconverge-recovery'
    $tar='/sdcard/DroidConverge-backups/droidconverge-termux-2026-09-15.tar'
    $paths=@('anland-bridge.sh','anland-haptic-test','start-ubuntu-kde.sh','startplasma-anland.sh','.shortcuts/tasks/Ubuntu-KDE','.termux/tasker/haptic')
    & $Adb shell "rm -rf $remote; mkdir -p $remote; tar -xf $tar -C $remote $($paths -join ' ')" 2>&1 | Tee-Object -FilePath $LogFile -Append | Out-Host
    if($LASTEXITCODE -ne 0){Add-Warn 'Estrazione Termux dal checkpoint fallita.';return}
    New-Item -ItemType Directory -Force (Join-Path $Recovery 'termux') | Out-Null
    & $Adb pull "$remote/." (Join-Path $Recovery 'termux') 2>&1 | Tee-Object -FilePath $LogFile -Append | Out-Host
    if($LASTEXITCODE -eq 0){Add-Ok 'Recuperati gli script Termux/Anland selezionati.'}else{Add-Warn 'ADB pull Termux fallito.'}
    & $Adb shell "rm -rf $remote" 2>&1 | Out-Null
}

function Recover-Ubuntu {
    if($SkipAdb){return}
    if(-not(Test-Path $Adb)){return}
    $devices = & $Adb devices 2>&1 | Out-String
    if($devices -notmatch '(?m)^\S+\s+device\s*$'){return}
    $dest=Join-Path $Recovery 'ubuntu'
    if(Test-Path (Join-Path $dest 'scripts\home\android\start-anland-plasma.sh')){Add-Ok 'Recovery Ubuntu già disponibile localmente.';return}
    $remote='/data/local/tmp/droidconverge-ubuntu-selected.tar'
    $base='/sdcard/DroidConverge-backups/droidconverge-ubuntu-snapshot'
    $cmd="cd '$base' && tar -cf '$remote' scripts configs/droidconverge.json.example maliit/backup plasma-mobile/backup build-info/file-list.txt build-info/sha256.txt build-info/system.txt"
    & $Adb shell $cmd 2>&1 | Tee-Object -FilePath $LogFile -Append | Out-Host
    if($LASTEXITCODE -ne 0){Add-Warn 'Recupero selettivo Ubuntu dal checkpoint fallito.';return}
    New-Item -ItemType Directory -Force $dest | Out-Null
    $local=Join-Path $dest 'selected.tar'
    & $Adb pull $remote $local 2>&1 | Tee-Object -FilePath $LogFile -Append | Out-Host
    if($LASTEXITCODE -eq 0){
        try { tar -xf $local -C $dest; Remove-Item $local -Force; Add-Ok 'Recuperati script/config/backup metadata Ubuntu selezionati.' }
        catch { Add-Warn "Estrazione Ubuntu locale fallita: $($_.Exception.Message)" }
    }
    & $Adb shell "rm -f $remote" 2>&1 | Out-Null
}

function Import-Termux {
    $root=Join-Path $Recovery 'termux\droidconverge-recovery'
    if(-not(Test-Path $root)){Add-Warn 'Recovery Termux non disponibile.';return}
    $map=@{
      'anland-bridge.sh'='scripts\termux\anland-bridge.sh'
      'anland-haptic-test'='scripts\termux\anland-haptic-test'
      'start-ubuntu-kde.sh'='scripts\termux\start-ubuntu-kde.sh'
      'startplasma-anland.sh'='scripts\termux\startplasma-anland.sh'
      '.shortcuts\tasks\Ubuntu-KDE'='scripts\termux\.shortcuts\tasks\Ubuntu-KDE'
      '.termux\tasker\haptic'='scripts\termux\.termux\tasker\haptic'
    }
    foreach($k in $map.Keys){$s=Join-Path $root $k;if(Test-Path $s){Copy-NoOverwrite $s (Join-Path $Repo $map[$k])}}
    $installer=Join-Path $Repo 'scripts\termux\install-droidconverge-termux.sh'
    if(-not(Test-Path $installer)){
@'
#!/data/data/com.termux/files/usr/bin/bash
set -eu
REPO_URL="${DROIDCONVERGE_REPO_URL:-https://github.com/VulcasX/droidconverge.git}"
DEST="${DROIDCONVERGE_INSTALL_DIR:-$HOME/.local/share/droidconverge}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
command -v git >/dev/null 2>&1 || { echo "ERROR: git is required." >&2; exit 1; }
git clone --depth 1 "$REPO_URL" "$TMP/repo" >/dev/null 2>&1
mkdir -p "$DEST" "$HOME/.shortcuts/tasks" "$HOME/.termux/tasker"
cp "$TMP/repo/scripts/termux/"*.sh "$DEST/" 2>/dev/null || true
cp "$TMP/repo/scripts/termux/anland-haptic-test" "$DEST/" 2>/dev/null || true
chmod +x "$DEST/"* 2>/dev/null || true
cp "$TMP/repo/scripts/termux/.shortcuts/tasks/Ubuntu-KDE" "$HOME/.shortcuts/tasks/Ubuntu-KDE" 2>/dev/null || true
cp "$TMP/repo/scripts/termux/.termux/tasker/haptic" "$HOME/.termux/tasker/haptic" 2>/dev/null || true
chmod +x "$HOME/.shortcuts/tasks/Ubuntu-KDE" "$HOME/.termux/tasker/haptic" 2>/dev/null || true
echo "DroidConverge Termux integration installed under $DEST"
'@ | Set-Content -LiteralPath $installer -Encoding utf8NoBOM
        Add-Ok 'Creato installer Termux.'
    }
}

function Import-Ubuntu {
    $root=Join-Path $Recovery 'ubuntu'
    if(-not(Test-Path $root)){Add-Warn 'Recovery Ubuntu non disponibile.';return}
    $scriptRoot=Join-Path $root 'scripts'
    if(Test-Path $scriptRoot){
      Get-ChildItem $scriptRoot -File -Recurse | Where-Object {$_.FullName -notmatch '\\.config\\'} | ForEach-Object {
        $rel=$_.FullName.Substring($scriptRoot.Length).TrimStart('\')
        $rel=$rel -replace '^home\\android\\','home\\android\\'
        Copy-NoOverwrite $_.FullName (Join-Path $Repo ('scripts\ubuntu\'+$rel))
      }
    }
    $cfg=Join-Path $root 'configs\droidconverge.json.example'
    if(Test-Path $cfg){Copy-NoOverwrite $cfg (Join-Path $Repo 'configs\droidconverge.json.example')}
    $review=Join-Path $Repo 'checkpoint-recovery\ubuntu\review'
    New-Item -ItemType Directory -Force $review | Out-Null
    foreach($c in @('maliit','plasma-mobile')){
      $b=Join-Path $root "$c\backup"
      if(Test-Path $b){$d=Join-Path $review $c;if(-not(Test-Path $d)){Copy-Item $b $d -Recurse -Force;Add-Ok "Preservati per revisione i backup $c."}}
    }
}

function Ensure-Docs {
    if($SkipDocs){Add-Warn 'Documentazione saltata (-SkipDocs).';return}
    $d=Join-Path $Repo 'docs';New-Item -ItemType Directory -Force $d|Out-Null
    $p=Join-Path $d 'TERMUX-INTEGRATION.md'
    if(-not(Test-Path $p)){
@'
# DroidConverge — Termux / Anland integration

This repository contains project-owned helper scripts for the Android/Termux + Anland + Ubuntu/KDE integration used during development.

## Security

Never commit the real DroidConverge haptic token, personal Android/Termux configuration, signing keys, raw checkpoint archives, or private certificates. Use `configs/droidconverge.json.example` as the public template.

## Installation

Run `scripts/termux/install-droidconverge-termux.sh` from inside Termux after reviewing the device-specific paths in the recovered startup scripts.

Some scripts assume the existing `ubuntu26` chroot, the Anland Termux package, root access, and the device paths used by the development setup.
'@|Set-Content -LiteralPath $p -Encoding utf8NoBOM;Add-Ok 'Creato docs/TERMUX-INTEGRATION.md'
    }
    $p2=Join-Path $d 'RELEASE-PREFLIGHT.md'
@'
# DroidConverge release preflight

The release preflight runs before the Git commit and never performs `git commit` or `git push`.

It recovers selected checkpoint material, preserves conflicts instead of overwriting them, checks repository hygiene, runs Android tests/builds, and produces a report under `.release-work/`.

Production signing keys are never generated or published automatically. Verify the Android target SDK before Play publication.
'@|Set-Content -LiteralPath $p2 -Encoding utf8NoBOM;Add-Ok 'Aggiornato docs/RELEASE-PREFLIGHT.md'
}

function Hygiene {
    try { Run-Native git @('diff','--check') | Out-Null; Add-Ok 'git diff --check superato.' } catch { Add-Fail "git diff --check: $($_.Exception.Message)" }
    foreach($r in @('.release-work/','checkpoint-recovery/','DroidConvergeBridge/app/build/','DroidConvergeBridge/.gradle/')){Ensure-GitIgnore $r}
    $suspect=Get-ChildItem $Repo -File -Recurse -ErrorAction SilentlyContinue | Where-Object {
      $_.FullName -notmatch '\\(\.git|\.release-work|checkpoint-recovery|build|\.gradle)\\' -and $_.Extension -match '\.(kt|kts|java|xml|sh|bash|py|md|json|yml|yaml|conf|example)$'
    }
    $patterns=@('(?i)haptic_token\s*[=:]\s*["'']?[A-F0-9]{16,}','-----BEGIN (RSA|EC|OPENSSH|PRIVATE) KEY-----','(?i)(api[_-]?key|access[_-]?token|secret|password)\s*[=:]\s*["'']?[A-Za-z0-9_\-+/=]{16,}["'']?')
    foreach($f in $suspect){$raw=Get-Content -Raw $f.FullName -ErrorAction SilentlyContinue;if($raw){foreach($p in $patterns){if($raw -match $p){Add-Fail "Possibile segreto rilevato: $($f.FullName)";break}}}}
    Add-Ok 'Controllo segreti completato.'
}

function Android-Build {
    if($SkipAndroidBuild){Add-Warn 'Build Android saltata (-SkipAndroidBuild).';return}
    $proj=Join-Path $Repo 'DroidConvergeBridge';$gradlew=Join-Path $proj 'gradlew.bat'
    if(-not(Test-Path $gradlew)){Add-Fail 'Gradle wrapper non trovato.';return}
    $gradle=Join-Path $proj 'app\build.gradle.kts';$raw=Get-Content -Raw $gradle
    $m=[regex]::Match($raw,'targetSdk\s*=\s*(\d+)');if($m.Success){$sdk=[int]$m.Groups[1].Value;if($sdk -lt 36){Add-Fail "targetSdk=$sdk: per Google Play dal 31 agosto 2026 è richiesto API 36+ per nuove app e aggiornamenti."}else{Add-Ok "targetSdk=$sdk."}}else{Add-Warn 'targetSdk non rilevato automaticamente.'}
    try{Run-Native $gradlew @('test') $proj|Out-Null;Add-Ok 'Test Android superati.'}catch{Add-Fail "Test Android falliti: $($_.Exception.Message)"}
    try{Run-Native $gradlew @('assembleDebug') $proj|Out-Null;Add-Ok 'assembleDebug superato.'}catch{Add-Fail "assembleDebug fallito: $($_.Exception.Message)"}
}

function Android-Smoke {
    if($SkipAndroidInstall){Add-Warn 'Smoke test Android saltato (-SkipAndroidInstall).';return}
    if(-not(Test-Path $Adb)){Add-Warn 'ADB non disponibile per smoke test.';return}
    $apk=Get-ChildItem (Join-Path $Repo 'DroidConvergeBridge\app\build\outputs\apk') -Filter *.apk -Recurse -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1
    if(-not $apk){Add-Warn 'APK debug non trovato.';return}
    $devices=& $Adb devices 2>&1|Out-String;if($devices -notmatch '(?m)^\S+\s+device\s*$'){Add-Warn 'Nessun device ADB online.';return}
    & $Adb install -r $apk.FullName 2>&1|Tee-Object -FilePath $LogFile -Append|Out-Host
    if($LASTEXITCODE -eq 0){Add-Ok 'APK debug installato sul device.'}else{Add-Fail 'Installazione APK fallita.'}
}

try {
    Write-Log "Avvio preflight da $Repo"
    Ensure-GitIgnore '.release-work/'
    Ensure-GitIgnore 'checkpoint-recovery/'
    Recover-Termux
    Recover-Ubuntu
    Import-Termux
    Import-Ubuntu
    Ensure-Docs
    Hygiene
    Android-Build
    Android-Smoke

    $status=git status --short
    @(
      'DroidConverge release preflight report'
      "Generated: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"
      "Repository: $Repo"
      ''
      'FAILURES:'
      $(if($Failures.Count){$Failures|ForEach-Object{"  - $_"}}else{'  none'})
      ''
      'WARNINGS:'
      $(if($Warnings.Count){$Warnings|ForEach-Object{"  - $_"}}else{'  none'})
      ''
      'GIT STATUS:'
      $status
    ) | Set-Content -LiteralPath $Report -Encoding utf8NoBOM

    if(-not $KeepRecovery){ Add-Ok 'Le directory checkpoint-recovery/.release-work restano locali e ignorate; nessun commit/push viene eseguito.' }
    if($Failures.Count -gt 0){ Write-Log 'Preflight terminato con errori. Nessun commit/push.' ERROR; exit 2 }
    Write-Log 'Preflight completato senza errori bloccanti. Nessun commit/push.' OK
    Write-Host "`nREPORT: $Report" -ForegroundColor Green
    exit 0
}
catch {
    Add-Fail $_.Exception.Message
    @('DroidConverge release preflight report',"Generated: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')",'UNHANDLED ERROR:',$_.Exception.Message) | Set-Content -LiteralPath $Report -Encoding utf8NoBOM
    Write-Host "REPORT: $Report" -ForegroundColor Yellow
    exit 3
}
